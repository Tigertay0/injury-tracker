# ============================================
# PitchSafe — Environment Variables Template
# ============================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values in .env
# 3. NEVER commit .env — it is already in .gitignore
# ============================================

# -----------------------------------------------
# FIREBASE CONFIG  (Client-safe — VITE_ prefix)
# -----------------------------------------------
# These values ARE bundled into the browser JS build by Vite.
# This is expected and safe for Firebase:
#   - They identify your project, they do not grant access.
#   - Access is controlled entirely by Firestore Security Rules.
#   - See: https://firebase.google.com/docs/projects/api-keys
# Get these from: Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_hash

# -----------------------------------------------
# ANTHROPIC CLAUDE API KEY  (Server-side ONLY)
# -----------------------------------------------
# ⚠️  CRITICAL: This key is PRIVATE and must NEVER reach the browser.
#
# HOW THE SAFETY WORKS:
#   - No VITE_ prefix → Vite intentionally excludes it from client bundles.
#   - Used only by Firebase Cloud Functions (server-side), not frontend code.
#   - If you ever call import.meta.env.ANTHROPIC_API_KEY in src/ files,
#     Vite will return undefined — the value is never bundled.
#
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------
# RATE LIMITING  (Client-safe — VITE_ prefix)
# -----------------------------------------------
# Controls are enforced client-side via localStorage before every Firebase
# Auth or Firestore operation. These values are baked in at build time.
#
# Auth rate limits — login and registration
# Default: 5 attempts per 15 minutes (900000 ms) per email address
# STRICT: Do not raise above 10 without understanding brute-force implications.
VITE_RATE_LIMIT_AUTH_MAX=5
VITE_RATE_LIMIT_AUTH_WINDOW_MS=900000

# Data write rate limits — sessions, recovery, injuries, equipment
# Default: 20 writes per 60 seconds per authenticated user
VITE_RATE_LIMIT_WRITE_MAX=20
VITE_RATE_LIMIT_WRITE_WINDOW_MS=60000

# Delete rate limits — injury and session deletes
# Default: 10 deletes per 60 seconds per authenticated user
VITE_RATE_LIMIT_DELETE_MAX=10
VITE_RATE_LIMIT_DELETE_WINDOW_MS=60000

