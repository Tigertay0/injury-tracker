{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitchsafe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Public values only. CLERK_SECRET_KEY is a secret: `wrangler secret put CLERK_SECRET_KEY`
  // (and `.dev.vars` locally, which git ignores).
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_c3VwZXJiLXNwYW5pZWwtODEwLmNsZXJrLmFjY291bnRzLmRldiQ",
    "ALLOWED_ORIGINS": "https://pitchsafe.tiger-tayo.workers.dev"
  },
  // Neon Postgres through Hyperdrive (created with caching disabled so players always
  // read their latest writes). Local dev reads the connection string from the
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE variable in .env.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "bc2ce410b3324dd68df0b915c86bbe44" }],
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ]
}
